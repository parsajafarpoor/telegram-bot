# توکن ربات تلگرام (از BotFather)
BOT_TOKEN=

# آیدی عددی چتی که پیام‌های یادآوری در آن ارسال می‌شود
# (می‌توانید با دستور /chatid داخل همان چت آن را بگیرید)
CHAT_ID=@tavalod1s

# مسیر فایل اکسل حاوی نام و تاریخ تولد افراد
EXCEL_PATH=birthdays.xlsx

# ساعت ارسال یادآوری روزانه (به وقت تهران) به فرمت HH:MM
NOTIFY_TIME=09:00

# چند روز قبل از تولد یادآوری ارسال شود
DAYS_BEFORE=5
